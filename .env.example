# For running the API directly on your host machine:
DATABASE_URL=postgres://usage_app:local_dev_password@localhost:5433/usage_metering
PORT=3000

# Docker Compose interpolation defaults (override these for local use):
POSTGRES_DB=usage_metering
POSTGRES_USER=usage_app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5433
API_PORT=3000
CLIENT_PORT=8080
